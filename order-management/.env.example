# Environment Variables
NODE_ENV=production
PORT=3000

# MongoDB Connection (Atlas as default)
# Replace with your actual MongoDB connection string
MONGODB_URI="mongodb+srv://[username]:[password]@[cluster].mongodb.net/[database]?retryWrites=true&w=majority&appName=[appName]"


# Catalog API base URL for price lookups
# Example (HTTP): http://localhost:5225/api
# Example (HTTPS): https://localhost:7083/api
CATALOG_API_URL=https://localhost:7083/api
